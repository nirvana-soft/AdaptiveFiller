<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="HyakuninKumiteApplication.Views.GroupManagerView"
             Background="#F3F3F3" d:DesignWidth="1123.42" d:DesignHeight="630.5">

    <UserControl.Resources>
        <!-- Define a reusable style for vertically centered text -->
        <Style x:Key="CenterText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5, 0, 0, 0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel -->
        <Border Grid.Column="0" CornerRadius="5" Style="{StaticResource PanelBox}" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Groups" Grid.Column="0"/>

                    <Button Background="Transparent"
                            BorderThickness="0"
                            Padding="8"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Stretch"
                            Grid.Column="1"
                            Margin="5,0,0,0" Click="BtnAddGroup_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="+"
                            FontSize="18"
                            FontWeight="Bold"
                            VerticalAlignment="Center"
                            Margin="4,0,0,5"/>

                            <TextBlock Text="Add Group"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>
                </Grid>

                <Border Background="White" BorderBrush="{StaticResource PrimaryBorderColor}"
                            BorderThickness="1"
                            Grid.Row="1" CornerRadius="5"
                            Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="50"/>
                        </Grid.RowDefinitions>

                        <ListBox x:Name="LBCategoryGroups"
                                 SelectionChanged="LBGroups_SelectionChanged"
                                 Background="Transparent" 
                                 BorderBrush="Transparent" 
                                 ItemContainerStyle="{StaticResource ListBox}"
                                 Padding="0">
                        </ListBox>
                        <Button Content="Remove Group"
                                Grid.Row="3"
                                Grid.ColumnSpan="2"
                                Margin="12,0,12,16" Click="BtnRemoveGroup_Click"
                                />
                    </Grid>

                </Border>
            </Grid>
        </Border>


        <!-- Right Panel -->
        <Grid Grid.Column="1"
              Margin="10,0,6,0"
              Background="Transparent"
              >
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="160"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource PanelBox}"
                    CornerRadius="5">
                <TextBlock 
                    Text="Group {index}"
                    VerticalAlignment="Center"
                    Margin="20"
                    FontSize="16"
                    FontWeight="Bold"
                    x:Name="lblGroupName"></TextBlock>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource PanelBox}"
                    CornerRadius="5"
                    Margin="0,10,0,0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <TextBlock 
                            Grid.Column="0"
                            Text="Divisions ({Count})"
                            x:Name="lblDivisions"
                            VerticalAlignment="Center"
                            Margin="10"
                            FontSize="14"
                            FontWeight="Bold"
                            HorizontalAlignment="Left"></TextBlock>

                        <Button 
                            Grid.Column="1"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="8"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            Margin="0,0,20,0"
                            Click="BtnAddDiv_Click">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="⚙️"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    VerticalAlignment="Center"
                                    Margin="4,0,0,0"/>

                                <TextBlock Text="Manage Divisions"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1"  HorizontalScrollBarVisibility="Auto"
              VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="DivPanel"
                                  AllowDrop="True"
                                  Drop="DivPanel_Drop"
                                  Grid.Row="1">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="6"
                                        Padding="10"
                                        VerticalAlignment="Top"
                                        BorderBrush="{StaticResource BorderColor}"
                                        BorderThickness="1"
                                        PreviewMouseLeftButtonDown="Card_MouseDown"
                                        MouseMove="Card_MouseMove"
                                        Width="170"
                                        Height="65"
                                        CornerRadius="5">
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>

                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="White"/>

                                                <Style.Triggers>

                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                    </Trigger>

                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
                    
            </Border>

            <Border Grid.Row="2" Style="{StaticResource PanelBox}"
                    Margin="0,10,0,0"
                    CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock 
                            Grid.Row="0"
                            Text="Matches List" 
                           FontSize="14" 
                           VerticalAlignment="Center"
                           Margin="10"
                           FontWeight="Bold"
                           x:Name="txtWCHeader"></TextBlock>

                    <TextBox Grid.Row="0" x:Name="TBMatchSearch"
                                Height="24"
                                Width="250"
                                HorizontalAlignment="Right"
                                Margin="0,0,8,0"
                                TextChanged="TBMatchSearch_TextChanged"
                                GotFocus="TBMatchSearch_GotFocus"
                                LostFocus="TBMatchSearch_LostFocus"
                                Text="Filter matches..."
                             Background="{StaticResource PrimaryBgColor}"/>

                    <Border Grid.Row="1" 
                            Background="White"
                            Style="{StaticResource PanelBox}"
                            BorderBrush="Transparent">
                        <DataGrid x:Name="MatchesGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          SelectionMode="Single"
                          SelectionChanged="MatchesGrid_SelectionChanged"
                          Background="White"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="LightGray"
                          BorderBrush="Transparent"
                          RowHeight="34">

                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="4,0"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="Foreground" Value="Black"/>
                                            <Setter Property="BorderBrush" Value="LightGray"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>

                            <DataGrid.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding MatchCompNumber}" Width="40" ElementStyle="{StaticResource CenterText}"/>
                                <DataGridTextColumn Header="#bfr" Binding="{Binding PreMatchNum}" Width="80" ElementStyle="{StaticResource CenterText}"/>
                                <DataGridTextColumn Header="#nxt" Binding="{Binding NextMatchNum}" Width="80" ElementStyle="{StaticResource CenterText}"/>
                                <DataGridTextColumn Header="Round" Binding="{Binding Round}" Width="80" ElementStyle="{StaticResource CenterText}"/>
                                <DataGridTemplateColumn Header="Division" Width="400">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DivisionName}" 
                                               Cursor="Hand"
                                               VerticalAlignment="Center"
                                               MouseLeftButtonDown="DivisionName_Click"
                                                       Tag="{Binding}"/>

                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Shiro" Width="170">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ShiroName}" 
                                               Cursor="Hand"
                                               Foreground="{Binding ShiroForeground}"
                                               VerticalAlignment="Center"
                                               Tag="0"
                                               MouseLeftButtonDown="ParticipantName_Click" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Aka Column -->
                                <DataGridTemplateColumn Header="Aka" Width="170">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding AkaName}" 
                                               Cursor="Hand"
                                               Foreground="{Binding AkaForeground}"
                                               VerticalAlignment="Center"
                                               Tag="1"
                                               MouseLeftButtonDown="ParticipantName_Click" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Winner" Binding="{Binding WinnerName}" Width="*" ElementStyle="{StaticResource CenterText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</UserControl>
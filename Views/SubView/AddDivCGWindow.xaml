<Window x:Class="HyakuninKumiteApplication.Views.SubView.AddDivCGWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HyakuninKumiteApplication.Views.SubView"
        mc:Ignorable="d"
        Title="Select Divisions for your Category Group..." Height="450" Width="300"
        ResizeMode="NoResize">
    <Grid VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0">
            <ListBox x:Name="LBDivisions"
                     SelectionMode="Multiple"/>
        </Border>

        <Button Margin="0, 20, 0, 20" Width="150" Grid.Row="1" Content="Add Selected"
            Click="AddSelected_Click"/>
    </Grid>
</Window>

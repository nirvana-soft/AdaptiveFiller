<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="HyakuninKumiteApplication.Views.BracketsView"
             Background="#F3F3F3" d:DesignWidth="1123.42" d:DesignHeight="630.5">

    <Grid Margin="6" MouseLeftButtonDown="Background_Click">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="5" Style="{StaticResource PanelBox}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Age Groups" Grid.Row="0"/>

                        <Button Background="Transparent"
                            BorderThickness="0"
                            Padding="8"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Stretch"
                            Grid.Column="1"
                            Margin="5,0,0,0" Click="BtnAddAgeGroup_Click">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="+"
                            FontSize="18"
                            FontWeight="Bold"
                            VerticalAlignment="Center"
                            Margin="-4,0,0,3"/>

                                <TextBlock Text="Add Age Group"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>
                    </Grid>

                    <Border Background="White" BorderBrush="{StaticResource PrimaryBorderColor}"
                            BorderThickness="1"
                            Grid.Row="1" CornerRadius="5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition Height="50"/>
                            </Grid.RowDefinitions>

                            <ListBox 
                                Grid.Row="0"
                                x:Name="LBAgeGroups"
                                 SelectionChanged="LBAgeGroups_SelectionChanged"                                
                                 Background="Transparent" 
                                 BorderBrush="Transparent" 
                                 ItemContainerStyle="{StaticResource ListBox}"
                                 Padding="0"
                                KeyDown="LBAgeGroups_KeyDown">
                            </ListBox>

                            <Grid Grid.Row="1" Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Age Range:" VerticalAlignment="Center" Grid.Row="0"/>
                                <Grid Grid.Row="0" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="3*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Style="{StaticResource NumberTextBox}" PreviewTextInput="TB_PreviewTextInput" KeyDown="TBAge_KeyDown" x:Name="TBMinAge" Text="8" Grid.Row="0" Grid.Column="0"/>
                                    <TextBlock Text="to"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Grid.Row="0" Grid.Column="1"/>
                                    <TextBox Style="{StaticResource NumberTextBox}" PreviewTextInput="TB_PreviewTextInput" KeyDown="TBAge_KeyDown" x:Name="TBMaxAge" Text="17" Grid.Row="0" Grid.Column="2"/>
                                </Grid>
                            </Grid>
                        </Grid>

                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="1" CornerRadius="5" Style="{StaticResource PanelBox}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Weight Categories" Grid.Column="0"/>

                        <StackPanel Grid.Column="1"
                                    FlowDirection="LeftToRight"
                                    Orientation="Horizontal">
                            <RadioButton Margin="0,0,5,0" VerticalAlignment="Center"
                                         IsChecked="True"
                                         GroupName="GenderSelection"
                                         Checked="GenderMaleRB_Checked">Male</RadioButton>
                            <RadioButton VerticalAlignment="Center"
                                         GroupName="GenderSelection"
                                         Checked="GenderFemaleRB_Checked">Female</RadioButton>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Background="White">
                        <Grid >
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="35"/>
                            </Grid.RowDefinitions>

                            <ListBox 
                                 Grid.Row = "0"
                                 x:Name="LBWeightCategories"
                                 SelectionChanged="LBWeightCategories_SelectionChanged"
                                 Background="Transparent" 
                                 BorderBrush="Transparent" 
                                 ItemContainerStyle="{StaticResource ListBox}"
                                 Padding="0"
                                KeyDown="LBWeightCategories_KeyDown">
                            </ListBox>

                            <Grid Grid.Row="1" Margin="10, 0, 10, 0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Weight:" VerticalAlignment="Center" Grid.Row="0"/>
                                <Grid Grid.Row="0" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="3*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Style="{StaticResource NumberTextBox}" PreviewTextInput="TB_PreviewTextInput" KeyDown="TBWeight_KeyDown" x:Name="TBMinWeight" Text="0" Grid.Row="0" Grid.Column="0"/>
                                    <TextBlock Text="to"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Grid.Row="0" Grid.Column="1"/>
                                    <TextBox Style="{StaticResource NumberTextBox}" PreviewTextInput="TB_PreviewTextInput" KeyDown="TBWeight_KeyDown" x:Name="TBMaxWeight" Text="0" Grid.Row="0" Grid.Column="2"/>
                                </Grid>
                            </Grid>

                            <Grid Grid.Row="2" Margin="10, 0, 10, 5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Interval:" VerticalAlignment="Center" Grid.Row="0"/>
                                <Grid Grid.Row="0" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="6*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Style="{StaticResource NumberTextBox}" PreviewTextInput="TB_PreviewTextInput" KeyDown="TBWeight_KeyDown" x:Name="TBWeightInterval" Text="0" Grid.Row="0" Grid.Column="0"/>
                                    <Button Grid.Column="2" Margin="0,3,0,3" Click="btnGenerateWC_Click">Generate</Button>
                                </Grid>
                            </Grid>
                        </Grid>

                    </Border>
                </Grid>
            </Border>

        </Grid>

        <!-- Right Panel -->
        <Grid Grid.Column="1"
              Margin="10,0,6,0"
              Background="Transparent"
              >
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource PanelBox}"
                    CornerRadius="5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width='4*'/>
                        <ColumnDefinition Width='6*'/>
                        <ColumnDefinition Width='5*'/>
                        <ColumnDefinition Width='5*'/>
                        <ColumnDefinition Width='5*'/>
                        <ColumnDefinition Width='3*'/>
                    </Grid.ColumnDefinitions>

                    <Button Content="Matchmake"
                                Grid.Column="0"
                                Margin="5,0,0,0"
                                Click="BtnMatchmake_Click"
                                HorizontalAlignment="Stretch"
                                Height="30"
                                />

                    <Button Content="Numberize Elements ▾" 
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            Margin="10,0,10,0"
                            VerticalAlignment="Center" 
                            Padding="10,6"
                            Click="BtnNumberizeElem_Click"
                            Height="30"
                            >
                        <Button.ContextMenu>
                            <ContextMenu x:Name="Btn_NumberizeElem">
                                <MenuItem StaysOpenOnClick="True">
                                    <MenuItem.Header>
                                        <CheckBox Content="Numberize Participants" IsChecked="True"/>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem StaysOpenOnClick="True">
                                    <MenuItem.Header>
                                        <CheckBox Content="Numberize Matches" IsChecked="True"/>
                                    </MenuItem.Header>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <TextBlock 
                            Grid.Column="2"
                            Text="Total Participants: 100" 
                           FontSize="11" 
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                        
                           Margin="0"
                           x:Name="txtInfo1"></TextBlock>
                    <TextBlock 
                            Grid.Column="3"
                            Text="Total Matches: 100" 
                           FontSize="11" 
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                        
                           Margin="0"
                           x:Name="txtInfo2"></TextBlock>
                    <TextBlock 
                            Grid.Column="4"
                            Text="Awaiting Matchmaking" 
                           FontSize="11" 
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="0"
                           x:Name="txtInfo3"></TextBlock>
                    <Button Content="Export PDF"
                                Grid.Column="5"
                                Click="BtnExportPDF_Click"
                                HorizontalAlignment="Stretch"
                                Height="30"
                                />

                </Grid>

            </Border>

            <Border Grid.Row="1" Style="{StaticResource PanelBox}"
                    Margin="0,10,0,0"
                    CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock 
                            Grid.Row="0"
                            Text="Division X-X Years old -Y kg" 
                           FontSize="18" 
                           VerticalAlignment="Center"
                           Margin="20"
                           FontWeight="Bold"
                           x:Name="txtWCHeader"></TextBlock>

                    <Border Grid.Row="1" 
                            Background="White"
                            Style="{StaticResource PanelBox}"
                            BorderBrush="Transparent">
                        <ScrollViewer  x:Name="MyScrollViewer"
                                       ScrollViewer.CanContentScroll="True"
                                HorizontalScrollBarVisibility="Auto" 
                              VerticalScrollBarVisibility="Auto"
                              PreviewMouseLeftButtonDown="ScrollViewer_PreviewMouseLeftButtonDown"
                              PreviewMouseMove="ScrollViewer_PreviewMouseMove"
                              PreviewMouseLeftButtonUp="ScrollViewer_PreviewMouseLeftButtonUp"
                              KeyDown="Window_KeyDown" KeyUp="Window_KeyUp" Focusable="True">
                            <Border x:Name="BracketBorder" Padding="0,0,5,5">

                            </Border>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</UserControl>
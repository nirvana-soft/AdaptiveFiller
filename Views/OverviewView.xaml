<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="HyakuninKumiteApplication.Views.OverviewView"
             Background="#F3F3F3" d:DesignWidth="1200" d:DesignHeight="680">

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="150"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top info --> 
        <Border Grid.Row="0" CornerRadius="5" Style="{StaticResource PanelBox}" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="28"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Competition Name:" Grid.Row="0"/>
                    <TextBox x:Name="TBName" Text="2025 Spring Tournament" Grid.Row="0" Grid.Column="1"/>

                    <TextBlock Text="Date:" Grid.Row="1"/>
                    <TextBox x:Name="TBDate" Text="5/24/2025" Grid.Row="1" Grid.Column="1"/>

                    <TextBlock Text="Location:" Grid.Row="2"/>
                    <TextBox x:Name="TBLocation" Text="Tokyo Budokan" Grid.Row="2" Grid.Column="1"/>

                    <TextBlock Text="Format:" Grid.Row="3"/>
                    <TextBox x:Name="TBFormat" Text="Hyakunin Kumite" Grid.Row="3" Grid.Column="1"/>
                </Grid>

                <Border Grid.Column="1" Background="{StaticResource BorderColor}" Margin="15,0"/>

                <Grid Margin="10" Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="28"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Participants:" Grid.Row="0"/>
                    <TextBlock x:Name="txtPartCount" Text="148" Grid.Row="0" Grid.Column="1"/>

                    <TextBlock Text="Kumite Divisions:" Grid.Row="1"/>
                    <TextBlock x:Name="txtKumiteDivCount" Text="12" Grid.Row="1" Grid.Column="1"/>

                    <TextBlock Text="Kata Divisions:" Grid.Row="2"/>
                    <TextBlock x:Name="txtKataDivCount" Text="8" Grid.Row="2" Grid.Column="1"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Middle -->
        <Grid Grid.Row="1" Margin="0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBox}"
                    Margin="0,0,6,0"
                    CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Participants"
                               FontWeight="Bold"
                               Margin="8"
                               Grid.Row="0"/>

                    <Button Background="Transparent"
                            BorderThickness="0"
                            Padding="8"
                            HorizontalAlignment="Left"
                            Grid.Row="1"
                            Margin="5,0,5,0" Click="BtnUploadViaExcel_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="+"
                            FontSize="18"
                            FontWeight="Bold"
                            VerticalAlignment="Center"
                            Margin="4,0,0,3"/>

                            <TextBlock Text="Add Participant List via Excel"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                    <Button Background="Transparent"
                            BorderThickness="0"
                            Padding="8"
                            HorizontalAlignment="Left"
                            Grid.Row="1"
                            Margin="190,0,5,0" Click="BtnExportPart_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="🖨️"
                            FontSize="17"
                            VerticalAlignment="Center"
                            Margin="4,0,0,3"/>

                            <TextBlock Text="Export Participant List via Excel"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                    <Button Background="Transparent"
                            BorderThickness="0"
                            Padding="8"
                            HorizontalAlignment="Left"
                            Grid.Row="1"
                            Margin="400,0,5,0" Click="BtnClearPart_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="🗑️"
                            FontSize="17"
                            VerticalAlignment="Center"
                            Margin="4,0,0,3"/>

                            <TextBlock Text="Clear Participants List"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                    <TextBox Grid.Row="1" x:Name="TBParticipantSearch"
                                Height="24"
                                Width="250"
                                HorizontalAlignment="Right"
                                Margin="0,0,8,0"
                                TextChanged="TBParticipantSearch_TextChanged"
                                GotFocus="TBParticipantSearch_GotFocus"
                                LostFocus="TBParticipantSearch_LostFocus"
                                Text="Search participants..."
                             Background="{StaticResource PrimaryBgColor}"/>
 
                    <DataGrid x:Name="ParticipantGrid"
                              Grid.Row="2"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="All"
                              RowHeight="24"
                              Background="{StaticResource PrimaryBgColor}"
                              ColumnHeaderHeight="30"
                              BorderBrush="Transparent"
                              CanUserAddRows="True"
                              HorizontalScrollBarVisibility="Hidden"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              >

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Width="30" Binding="{Binding CompId}"/>
                            <DataGridTextColumn Header="Name" Width="120" Binding="{Binding Name}"/>
                            <DataGridTextColumn Header="Surname" Width="120" Binding="{Binding Surname}"/>
                            <DataGridTextColumn Header="Country" Width="100" Binding="{Binding Country}"/>
                            <DataGridTextColumn Header="Gender" Width="60" Binding="{Binding Gender}"/>
                            <!-- Date of Birth Column with DatePicker -->
                            <DataGridTemplateColumn Header="Date of Birth">
                                <!-- What displays when the cell is NOT being edited -->
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DateOfBirth, StringFormat={}{0:yyyy-MM-dd}}" 
                               VerticalAlignment="Center" Margin="5,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>

                                <!-- What displays when the cell IS being edited (clicked) -->
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <DatePicker SelectedDate="{Binding DateOfBirth, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Age" Width="50" Binding="{Binding Age}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="BC" Width="100" Binding="{Binding BC}"/>
                            <DataGridTextColumn Header="DOP" Width="120" Binding="{Binding DOP}"/>
                            <DataGridTextColumn Header="Weight" Width="50" Binding="{Binding Weight}"/>

                            <DataGridCheckBoxColumn Header="Kumite" Width="80" Binding="{Binding Kumite}"/>
                            <DataGridCheckBoxColumn Header="Kata" Width="80" Binding="{Binding Kata}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="1" CornerRadius="5" Style="{StaticResource PanelBox}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="150"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Text="Group Generator"
                               FontWeight="Bold"
                               Margin="8"/>

                    <ListBox x:Name="LBAgeGroups"
                             Grid.Row="1"
                             Margin="4"
                             Background="Transparent"/>
                    
                    <Grid Grid.Row="2" Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="40"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Age Range:" Grid.Row="0"/>
                        <Grid Grid.Row="0" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Style="{StaticResource NumberTextBox}" x:Name="TBMinAge" Text="8" Grid.Row="0" Grid.Column="0"/>
                            <TextBlock Text="to"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Grid.Row="0" Grid.Column="1"/>
                            <TextBox Style="{StaticResource NumberTextBox}" x:Name="TBMaxAge" Text="17" Grid.Row="0" Grid.Column="2"/>
                        </Grid>

                        <TextBlock Text="Age Interval:" Grid.Row="1"/>
                        <TextBox Style="{StaticResource NumberTextBox}" x:Name="TBAgeInterval" Text="2" Grid.Row="1" Grid.Column="1"/>

                        <TextBlock Text="Weight Interval:" Grid.Row="2"/>
                        <TextBox Style="{StaticResource NumberTextBox}" x:Name="TBWeightInterval" Text="5" Grid.Row="2" Grid.Column="1"/>


                        <Button Content="Generate Groups"
                                Grid.Row="3"
                                Grid.ColumnSpan="2"
                                Margin="0,8,0,0"
                                />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>